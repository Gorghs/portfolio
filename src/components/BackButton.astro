---
import { Icon } from "astro-icon/components";

interface Props {
  mobileText?: string;
  desktopText?: string;
}

const { mobileText = "Back", desktopText = "Back to Portfolio" } = Astro.props;
---

<a
  href="/"
  class="group inline-flex items-center gap-2 rounded-full border border-slate-200/80 dark:border-slate-800/80 bg-slate-100 dark:bg-slate-800/50 px-4 py-2 text-sm font-semibold text-slate-800 dark:text-teal-300 transition-all duration-200 ease-out-strong hover:bg-slate-200/80 dark:hover:bg-slate-700/60 hover:text-slate-950 dark:hover:text-teal-200 active:scale-[0.97] focus:outline-none focus:ring-2 focus:ring-slate-400 dark:focus:ring-teal-300/50"
>
  <Icon
    name="lucide:arrow-left"
    class="h-4 w-4 transition-transform duration-200 ease-out-strong group-hover:-translate-x-1"
  />
  <span class="sm:hidden">{mobileText}</span>
  <span class="hidden sm:inline">{desktopText}</span>
</a>
