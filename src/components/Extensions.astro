---
import { Icon } from "astro-icon/components";
import { extensions, sectionDescriptions } from "../data/portfolio.json";
---

<section
  id="extensions"
  class="mb-4 scroll-mt-16 lg:mb-16 lg:scroll-mt-24"
  aria-label="Browser Extensions"
>
  <div
    class="sticky top-0 z-20 -mx-6 mb-6 w-[100vw] max-w-[100vw] bg-white/90 dark:bg-slate-950/90 px-6 py-5 pb-4 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:max-w-full lg:px-0 lg:py-0 lg:opacity-0 lg:mb-4"
  >
    <h2
      class="text-sm font-extrabold uppercase tracking-widest text-slate-900 dark:text-slate-100 lg:sr-only"
    >
      Extensions
    </h2>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 lg:hidden">
      {sectionDescriptions.extensions}
    </p>
  </div>
  <div>
    <ul class="group/list">
      {
        extensions.map((extension) => (
          <li class="mb-12">
            <div class="group relative grid gap-4 pb-1 transition-all duration-200 rounded-xl p-4 sm:p-5 bg-white dark:bg-slate-900/40 border border-slate-200/80 dark:border-slate-800/80 hover:bg-slate-50/90 dark:hover:bg-slate-800/50 hover:border-slate-300 dark:hover:border-slate-700/80 shadow-xs dark:shadow-none">
              <div class="z-10 sm:order-2 sm:col-span-8">
                <h3>
                  <a
                    class="inline-flex items-baseline font-bold text-lg text-slate-900 dark:text-slate-100 group-hover/link:text-teal-700 dark:group-hover/link:text-teal-400 hover:text-teal-700 dark:hover:text-teal-400 transition-colors group/link"
                    href={extension.link || "#"}
                    target="_blank"
                    rel="noreferrer"
                    aria-label={extension.title}
                  >
                    <span class="absolute inset-0 rounded-xl" />
                    <span>
                      {extension.title}{" "}
                      {extension.link && (
                        <span class="inline-block">
                          <Icon
                            name="lucide:arrow-up-right"
                            class="inline-block h-4 w-4 shrink-0 transition-transform duration-200 ease-out-strong group-hover/link:-translate-y-1 group-hover/link:translate-x-1 group-focus-visible/link:-translate-y-1 group-focus-visible/link:translate-x-1 motion-reduce:transition-none"
                            aria-hidden="true"
                          />
                        </span>
                      )}
                    </span>
                  </a>
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400 font-normal">
                  {extension.description}
                </p>

                <ul class="mt-2 flex flex-wrap" aria-label="Technologies used">
                  {extension.tags.map((tag) => (
                    <li class="mr-1.5 mt-2">
                      <div class="flex items-center rounded-md bg-slate-100 dark:bg-teal-400/10 border border-slate-200/80 dark:border-teal-500/20 px-3 py-1 text-xs font-semibold text-slate-800 dark:text-teal-300">
                        {tag}
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
<div class="mt-12">
  <a
    class="inline-flex items-center leading-tight text-slate-900 dark:text-slate-100 hover:text-teal-700 dark:hover:text-teal-400 font-bold group"
    aria-label="View All Extensions"
    href="/extensions/"
  >
    <span
      class="border-b border-transparent pb-px transition-colors duration-200 ease-out-strong group-hover:border-teal-700 dark:group-hover:border-teal-400 motion-reduce:transition-none"
    >
      View Full Extension List
    </span>
    <Icon
      name="lucide:arrow-right"
      class="ml-1 inline-block h-4 w-4 shrink-0 -translate-y-px transition-transform duration-200 ease-out-strong group-hover:translate-x-2 group-focus-visible:translate-x-2 motion-reduce:transition-none"
      aria-hidden="true"
    />
  </a>
</div>
