---
import { intro } from "../data/portfolio.json";
---

<div class="space-y-3">
  <h1 id="intro-title" class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100 sm:text-5xl">
    <a id="intro-name" href="/" class="hover:text-slate-700 dark:hover:text-teal-300 transition-colors">{intro.name}</a>
  </h1>
  <h2 class="text-lg sm:text-xl font-bold tracking-tight text-slate-900 dark:text-slate-200">
    {intro.title}
  </h2>
  <p class="max-w-xs leading-relaxed text-slate-600 dark:text-slate-400">
    Building {intro.bio}
  </p>
</div>
