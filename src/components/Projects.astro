---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { projects, sectionDescriptions } from "../data/portfolio.json";

// Import local images
import gitridImg from "../assets/projects/gitrid.png";
import quickqbImg from "../assets/projects/quickqb.png";
import earthifyImg from "../assets/projects/earthify.png";
import sherlockImg from "../assets/projects/sherlock.png";
import archImg from "../assets/projects/arch-portfolio.png";

// Map image keys to imports
const images: Record<string, ImageMetadata> = {
  gitrid: gitridImg,
  quickqb: quickqbImg,
  trackify: earthifyImg,
  earthify: earthifyImg,
  sherlock: sherlockImg,
  "arch-portfolio": archImg,
  "arch-simulation": archImg,
};
---

<section
  id="projects"
  class="mb-4 scroll-mt-16 lg:mb-16 lg:scroll-mt-24"
  aria-label="Selected projects"
>
  <div
    class="sticky top-0 z-20 -mx-6 mb-6 w-[100vw] max-w-[100vw] bg-white/90 dark:bg-slate-950/90 px-6 py-5 pb-4 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:max-w-full lg:px-0 lg:py-0 lg:opacity-0 lg:mb-4"
  >
    <h2
      class="text-sm font-extrabold uppercase tracking-widest text-slate-900 dark:text-slate-100 lg:sr-only"
    >
      Projects
    </h2>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 lg:hidden">
      {sectionDescriptions.projects}
    </p>
  </div>
  <div>
    <ul class="group/list">
      {
        projects.map((project, index) => (
          <li class="mb-12">
            <div class="group relative grid sm:grid-cols-12 gap-4 sm:gap-6 md:gap-5 pb-1 transition-all duration-200 rounded-xl p-4 sm:p-5 bg-white dark:bg-slate-900/40 border border-slate-200/80 dark:border-slate-800/80 hover:bg-slate-50/90 dark:hover:bg-slate-800/50 hover:border-slate-300 dark:hover:border-slate-700/80 shadow-xs dark:shadow-none">
              <div class="z-10 sm:order-2 sm:col-span-8">
                <h3 class="group/link">
                  <a
                    class="inline-flex items-baseline font-bold text-lg text-slate-900 dark:text-slate-100 group-hover/link:text-teal-700 dark:group-hover/link:text-teal-400 hover:text-teal-700 dark:hover:text-teal-400 focus-visible:text-teal-700 dark:focus-visible:text-teal-400 transition-colors"
                    href={project.link}
                    target="_blank"
                    rel="noreferrer"
                    aria-label={project.title}
                  >
                    <span class="absolute inset-0 rounded-xl" />
                    <span>
                      {project.title}{" "}
                      <span class="inline-block">
                        <span class="inline-block">
                          <Icon
                            name="lucide:arrow-up-right"
                            class="inline-block h-4 w-4 shrink-0 transition-transform duration-200 ease-out-strong group-hover/link:-translate-y-1 group-hover/link:translate-x-1 group-focus-visible/link:-translate-y-1 group-focus-visible/link:translate-x-1 motion-reduce:transition-none"
                            aria-hidden="true"
                          />
                        </span>
                      </span>
                    </span>
                  </a>
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400 font-normal">
                  {project.description}
                </p>
                <ul class="mt-2 flex flex-wrap" aria-label="Technologies used">
                  {project.tags.map((tag) => (
                    <li class="mr-1.5 mt-2">
                      <div class="flex items-center rounded-md bg-slate-100 dark:bg-teal-400/10 border border-slate-200/80 dark:border-teal-500/20 px-3 py-1 text-xs font-semibold text-slate-800 dark:text-teal-300">
                        {tag}
                      </div>
                    </li>
                  ))}
                </ul>
                {project.stats && project.stats.length > 0 && (
                  <p class="mt-3 text-xs font-semibold text-teal-700 dark:text-teal-400 flex items-center gap-1">
                    {project.stats.join(" · ")}
                  </p>
                )}
              </div>

              {images[project.image] ? (
                <div class="sm:order-1 sm:col-span-4 sm:translate-y-1 mb-4 sm:mb-0">
                  <Image
                    src={images[project.image]}
                    alt={`${project.title} project preview`}
                    width={600}
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : "auto"}
                    data-index={index}
                    sizes="(max-width: 640px) 100vw, 360px"
                    class="project-img rounded-lg border border-slate-200 dark:border-slate-800 shadow-xs transition-all duration-300 ease-out-strong group-hover:scale-[1.03] block w-full aspect-video object-cover"
                  />
                </div>
              ) : (
                <div class="rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-800 shadow-xs sm:order-1 sm:col-span-4 sm:translate-y-1 w-full aspect-video flex items-center justify-center text-slate-500 dark:text-slate-400 text-xs mb-4 sm:mb-0">
                  No image
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
<div class="mt-12">
  <a
    class="inline-flex items-center text-slate-900 dark:text-slate-100 hover:text-teal-700 dark:hover:text-teal-400 font-bold leading-tight group"
    aria-label="View Full Project Archive"
    href="/archive/"
  >
    <span
      class="border-b border-transparent pb-px transition group-hover:border-teal-700 dark:group-hover:border-teal-400 motion-reduce:transition-none"
    >
      View Full Project Archive
    </span>
    <Icon
      name="lucide:arrow-right"
      class="ml-1 inline-block h-4 w-4 shrink-0 -translate-y-px transition-transform group-hover:translate-x-2 group-focus-visible:translate-x-2 motion-reduce:transition-none"
      aria-hidden="true"
    />
  </a>
</div>

<script>
  // On desktop (lg: 1024px+), force all images to load eagerly
  if (window.matchMedia("(min-width: 1024px)").matches) {
    document
      .querySelectorAll<HTMLImageElement>(".project-img")
      .forEach((img) => {
        img.loading = "eager";
      });
  }
</script>
