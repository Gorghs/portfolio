---
import { Icon } from "astro-icon/components";
---

<button
  id="theme-toggle"
  aria-label="Toggle dark/light mode"
  aria-pressed="false"
  class="group fixed top-5 right-5 z-50 h-10 w-10 rounded-[10px] border border-slate-300 dark:border-slate-800 bg-white/80 dark:bg-slate-900/70 flex items-center justify-center cursor-pointer text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-slate-100 backdrop-blur-md shadow-xs transition-all duration-200 ease-out-strong"
>
  <Icon
    name="lucide:sun"
    class="h-5 w-5 hidden dark:block transition-transform duration-300 group-hover:rotate-45"
    aria-hidden="true"
  />
  <Icon
    name="lucide:moon"
    class="h-5 w-5 block dark:hidden transition-transform duration-300 group-hover:-rotate-12"
    aria-hidden="true"
  />
</button>

<style>
  #theme-toggle {
    transition:
      transform 160ms cubic-bezier(0.23, 1, 0.32, 1),
      color 180ms cubic-bezier(0.23, 1, 0.32, 1),
      border-color 180ms cubic-bezier(0.23, 1, 0.32, 1),
      background-color 180ms cubic-bezier(0.23, 1, 0.32, 1);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.18);
  }

  #theme-toggle:hover {
    color: var(--color-primary);
    border-color: color-mix(in srgb, var(--color-primary) 26%, transparent);
    background: color-mix(in srgb, var(--color-background) 74%, transparent);
    transform: translateY(-1px);
  }

  #theme-toggle:active {
    transform: scale(0.96);
  }

  #theme-toggle[data-busy="true"] {
    pointer-events: none;
  }

  :global(::view-transition-group(root)) {
    animation: none;
  }

  :global(::view-transition-old(root)),
  :global(::view-transition-new(root)) {
    animation: none;
    mix-blend-mode: normal;
    display: block;
  }

  :global(::view-transition-old(root)) {
    z-index: 1;
  }

  :global(::view-transition-new(root)) {
    z-index: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    #theme-toggle {
      transition: none !important;
    }
  }
</style>

<script>
  const toggle = document.getElementById("theme-toggle") as HTMLButtonElement | null;

  if (toggle) {
    const root = document.documentElement;
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const setTheme = (theme: string) => {
      root.setAttribute("data-theme", theme);
      if (theme === "dark") {
        root.classList.add("dark");
        root.classList.remove("light");
      } else {
        root.classList.remove("dark");
        root.classList.add("light");
      }
      localStorage.setItem("theme", theme);
      toggle.setAttribute("aria-pressed", String(theme === "light"));
    };

    const currentTheme = root.getAttribute("data-theme") || localStorage.getItem("theme") || "dark";
    setTheme(currentTheme);

    let isSwitching = false;

    const runWaveTransition = (nextTheme: string, x: number, y: number) => {
      if (isSwitching) {
        return;
      }

      isSwitching = true;
      toggle.dataset.busy = "true";

      const documentWithTransition = document as Document & {
        startViewTransition?: (updateCallback: () => void) => {
          ready: Promise<void>;
          finished: Promise<void>;
        };
      };

      const canUseViewTransition = Boolean(documentWithTransition.startViewTransition);

      if (!canUseViewTransition) {
        setTheme(nextTheme);
        delete toggle.dataset.busy;
        isSwitching = false;
        return;
      }

      const maxHorizontal = Math.max(x, window.innerWidth - x);
      const maxVertical = Math.max(y, window.innerHeight - y);
      const endRadius = Math.hypot(maxHorizontal, maxVertical);

      const transition = documentWithTransition.startViewTransition!(() => {
        setTheme(nextTheme);
      });

      transition.ready
        .then(() => {
          document.documentElement.animate(
            {
              clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${endRadius}px at ${x}px ${y}px)`],
            },
            {
              duration: 500,
              easing: "ease-in-out",
              pseudoElement: "::view-transition-new(root)",
            }
          );
        })
        .catch(() => {
          setTheme(nextTheme);
        });

      transition.finished.finally(() => {
        delete toggle.dataset.busy;
        isSwitching = false;
      });
    };

    toggle.addEventListener("click", () => {
      if (isSwitching) {
        return;
      }

      const current = root.getAttribute("data-theme") || "dark";
      const nextTheme = current === "dark" ? "light" : "dark";

      if (prefersReducedMotion.matches) {
        setTheme(nextTheme);
        return;
      }

      const rect = toggle.getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;

      runWaveTransition(nextTheme, x, y);
    });
  }
</script>
