---
import "../styles/global.css";
import { meta } from "../data/portfolio.json";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
  title?: string;
  description?: string;
  showPreloader?: boolean;
  wide?: boolean;
}

const {
  title = meta.title,
  description = meta.description,
  showPreloader = false,
  wide = false,
} = Astro.props;
const canonicalUrl = "https://karthickv.dev" + Astro.url.pathname;
const ogImage = "https://karthickv.dev/preview.png";
const ogImageAlt = "Preview of Karthick V's software development portfolio";

const SITE = "https://karthickv.dev/";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${SITE}#person`,
      "name": "Karthick V",
      "alternateName": "Gorghs",
      "url": SITE,
      "image": ogImage,
      "jobTitle": "Software Development Engineer",
      "description":
        "Software Development Engineer building backend services, developer tools, and workflow automation.",
      "email": "mailto:dev.karthickv@gmail.com",
      "worksFor": { "@type": "Organization", "name": "Ankor", "url": "https://ankor.in" },
      "alumniOf": {
        "@type": "CollegeOrUniversity",
        "name": "Saveetha Engineering College, Chennai",
      },
      "knowsAbout": [
        "Backend Development",
        "API Design",
        "Workflow Automation",
        "Developer Tools",
        "Browser Extensions",
        "TypeScript",
        "Python",
        "NestJS",
        "FastAPI",
        "GraphQL",
        "Docker",
      ],
      "sameAs": [
        "https://github.com/Gorghs",
        "https://www.linkedin.com/in/karthickv4/",
        "https://leetcode.com/u/gorghs/",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${SITE}#website`,
      "url": SITE,
      "name": "Karthick V",
      "inLanguage": "en",
      "publisher": { "@id": `${SITE}#person` },
    },
    {
      "@type": Astro.url.pathname === "/" ? "ProfilePage" : "CollectionPage",
      "@id": `${canonicalUrl}#webpage`,
      "url": canonicalUrl,
      "name": title,
      "description": description,
      "isPartOf": { "@id": `${SITE}#website` },
      ...(Astro.url.pathname === "/"
        ? { "mainEntity": { "@id": `${SITE}#person` } }
        : { "author": { "@id": `${SITE}#person` } }),
    },
  ],
};
const urlTheme = Astro.url.searchParams.get("theme");
const defaultTheme = urlTheme || "dark";
const isDefaultDark = defaultTheme === "dark";
---

<!doctype html>
<html lang="en" data-theme={defaultTheme} class:list={[{ dark: isDefaultDark, light: !isDefaultDark }, "scroll-smooth"]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="Karthick V" />
    <link rel="icon" href="https://fav.farm/⚡" type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="me" href="https://github.com/Gorghs" />
    <link rel="me" href="https://www.linkedin.com/in/karthickv4/" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content={Astro.url.pathname === "/" ? "profile" : "website"} />
    <meta property="og:site_name" content="Karthick V" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1919" />
    <meta property="og:image:height" content="1043" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {Astro.url.pathname === "/" && <meta property="profile:username" content="Gorghs" />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- Theme Initialization: Dark by default, prevents flash of wrong theme -->
    <script is:inline>
      (function() {
        var urlTheme = new URLSearchParams(window.location.search).get('theme');
        var stored = urlTheme || localStorage.getItem('theme');
        var theme = stored ? stored : 'dark';
        if (urlTheme) {
          try { localStorage.setItem('theme', urlTheme); } catch(e) {}
        }
        document.documentElement.setAttribute('data-theme', theme);
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
          document.documentElement.classList.remove('light');
        } else {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
        }
      })();
    </script>
  </head>
  <body
    class="bg-[var(--color-background)] text-[var(--color-primary)] antialiased selection:bg-teal-500/25 selection:text-teal-300 leading-relaxed min-h-screen relative"
  >
    <!-- Surface moving pointer glow -->
    <div
      id="pointer-glow"
      class="pointer-events-none fixed inset-0 z-0 transition-opacity duration-300"
      aria-hidden="true"
    ></div>

    <ThemeToggle />

    <div
      id="main-content"
      class:list={[
        "relative z-10 mx-auto min-h-screen px-6 font-sans md:px-12 md:py-20 lg:py-0",
        wide ? "max-w-none py-8" : "max-w-7xl lg:px-24 py-12",
      ]}
    >
      <div
        class:list={[
          "lg:flex lg:justify-between lg:gap-4",
          { "lg:block": wide },
        ]}
      >
        <!-- Left Column: Fixed/Sticky (hidden when wide) -->
        {
          !wide && (
            <header class="sidebar-header lg:sticky lg:top-0 lg:flex lg:h-screen lg:w-[calc(50%-0.5rem)] lg:flex-col lg:justify-between lg:overflow-y-auto lg:pt-24 lg:pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
              <slot name="sidebar" />
            </header>
          )
        }

        <!-- Right Column: Scrollable (Full width when wide) -->
        <main
          class:list={[
            "lg:pt-24 lg:pb-24",
            wide ? "lg:w-full pt-0" : "lg:w-[calc(50%-0.5rem)] lg:pb-96 pt-8",
          ]}
        >
          <slot />
        </main>
      </div>
    </div>

    <!-- Surface Pointer Glow Script -->
    <script is:inline>
      (function() {
        var glow = document.getElementById('pointer-glow');
        if (!glow) return;

        function getGlowGradient(x, y) {
          var isDark = (document.documentElement.getAttribute('data-theme') || 'dark') === 'dark';
          if (isDark) {
            return 'radial-gradient(850px circle at ' + x + 'px ' + y + 'px, rgba(56, 189, 248, 0.18), rgba(37, 99, 235, 0.08) 40%, transparent 75%)';
          } else {
            return 'radial-gradient(850px circle at ' + x + 'px ' + y + 'px, rgba(37, 99, 235, 0.14), rgba(96, 165, 250, 0.07) 45%, transparent 75%)';
          }
        }

        var lastX = -1000;
        var lastY = -1000;

        function updateGlow(x, y) {
          lastX = x;
          lastY = y;
          glow.style.background = getGlowGradient(x, y);
        }

        window.addEventListener('pointermove', function(e) {
          updateGlow(e.clientX, e.clientY);
        }, { passive: true });

        var observer = new MutationObserver(function() {
          if (lastX >= 0) {
            updateGlow(lastX, lastY);
          }
        });
        observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme', 'class'] });
      })();
    </script>
  </body>
</html>